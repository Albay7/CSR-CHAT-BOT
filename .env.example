# =====================================================================
# Cambridge Support RAG Bot - Environment Variables Template
# Copy this file to .env and configure your credentials:
#   copy .env.example .env
# =====================================================================

# Model Provider: "azure" or "openai"
MODEL_PROVIDER=azure

# --- Azure OpenAI Settings (Used when MODEL_PROVIDER=azure) ---
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Standard OpenAI Settings (Used when MODEL_PROVIDER=openai) ---
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- RAG Settings ---
SIMILARITY_TOP_K=4
SIMILARITY_THRESHOLD=0.3
